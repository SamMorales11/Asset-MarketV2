# ==============================================================================
# ASSET MARKET — VERCEL & PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env for local development or configure these variables
# directly in the Vercel Project Dashboard (Settings -> Environment Variables).

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Connection string to Neon Serverless PostgreSQL with SSL required.
# Example: postgresql://[user]:[password]@[neon-hostname].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. JWT AUTHENTICATION SECRETS (Required)
# ------------------------------------------------------------------------------
# Cryptographic secret keys for signing JWT tokens.
# Must be at least 32 characters long. Generate using: openssl rand -base64 32
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_min_32_chars_asset_market_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_min_32_chars_asset_market_2026
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. CORS & ORIGIN CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed client origins.
# Include your Vercel production domain and custom domain.
# Localhost origins (http://localhost:5173, etc.) are automatically allowed.
CORS_ORIGIN=https://asset-market.vercel.app,https://your-custom-domain.com

# ------------------------------------------------------------------------------
# 4. FRONTEND ENVIRONMENT VARIABLES (Vite / Client-Side)
# ------------------------------------------------------------------------------
# For Unified Vercel Deployment (Frontend + API in same project):
# Use relative path /api so all API requests route directly through Vercel.
VITE_API_BASE_URL=/api

# For Separate Deployment (Frontend on Vercel, Backend on Railway/Render/VPS):
# Uncomment and set your backend public API URL:
# VITE_API_BASE_URL=https://api.yourdomain.com/api

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME & METADATA (Optional)
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_URL=https://asset-market.vercel.app
PORT=3001

# ------------------------------------------------------------------------------
# 6. STORAGE DRIVER CONFIGURATION (Optional - for persistent cloud storage)
# ------------------------------------------------------------------------------
# Default is 'local' (uses /tmp on Vercel Serverless).
# For permanent production asset uploads, use 's3' (AWS S3, Cloudflare R2, Supabase):
STORAGE_DRIVER=local
# S3_BUCKET=asset-market-production
# S3_REGION=auto
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_PUBLIC_CDN_URL=https://cdn.yourdomain.com
